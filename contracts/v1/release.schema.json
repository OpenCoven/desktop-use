{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseManifestV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "OpenCoven/desktop-use"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^v0\\.1\\.[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "const": ".github/workflows/release.yml"
        },
        "ref": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^refs/(tags/v0\\.1\\.[0-9]+|heads/[A-Za-z0-9_./-]+|pull/[0-9]+/merge)$"
        }
      },
      "required": [
        "repository",
        "commit",
        "tag",
        "workflow",
        "ref"
      ]
    },
    "adapterProtocolVersion": {
      "const": 1
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation": {
          "const": 1
        },
        "capabilities": {
          "const": 1
        },
        "canonicalActions": {
          "const": 1
        }
      },
      "required": [
        "observation",
        "capabilities",
        "canonicalActions"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(tgz|tar\\.gz)$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 134217728
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256",
              "executable"
            ]
          }
        },
        "name": {
          "const": "@opencoven/openclaw-desktop-use"
        },
        "version": {
          "type": "string",
          "pattern": "^0\\.1\\.[0-9]+$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "adapterProtocolVersion": {
          "const": 1
        },
        "surfaces": {
          "const": [
            "plugin",
            "sdk",
            "mcp"
          ]
        }
      },
      "required": [
        "asset",
        "bytes",
        "sha256",
        "entries",
        "name",
        "version",
        "sourceCommit",
        "adapterProtocolVersion",
        "surfaces"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(tgz|tar\\.gz)$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 134217728
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "executable": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256",
                "executable"
              ]
            }
          },
          "target": {
            "enum": [
              "aarch64-apple-darwin",
              "x86_64-apple-darwin",
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu"
            ]
          },
          "minimumOsVersion": {
            "type": "string"
          },
          "libc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "family": {
                "const": "glibc"
              },
              "minimumVersion": {
                "const": "2.35"
              }
            },
            "required": [
              "family",
              "minimumVersion"
            ]
          },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not-run"
                ]
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$",
                    "maxLength": 2048
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "status",
              "url"
            ]
          }
        },
        "required": [
          "asset",
          "bytes",
          "sha256",
          "entries",
          "target",
          "minimumOsVersion",
          "signing"
        ]
      }
    },
    "qualifiedHosts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "enum": [
              "2026.4.26",
              "2026.11.3"
            ]
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "evidenceUrl": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "version",
          "integrity",
          "status",
          "evidenceUrl"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "urls": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "status",
            "urls"
          ]
        },
        "nativeSmoke": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "urls": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "status",
            "urls"
          ]
        },
        "cleanInstall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "urls": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "status",
            "urls"
          ]
        },
        "hostedGateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "urls": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "status",
            "urls"
          ]
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "urls": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "status",
            "urls"
          ]
        },
        "graphicalAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "urls": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "status",
            "urls"
          ]
        }
      },
      "required": [
        "build",
        "nativeSmoke",
        "cleanInstall",
        "hostedGateway",
        "publication",
        "graphicalAcceptance"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "releaseVersion",
    "source",
    "adapterProtocolVersion",
    "contracts",
    "package",
    "artifacts",
    "qualifiedHosts",
    "evidence"
  ]
}
