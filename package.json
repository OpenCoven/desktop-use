{
  "name": "@opencoven/openclaw-desktop-use",
  "version": "0.1.1",
  "description": "OpenCoven desktop-use adapter and OpenClaw plugin for computer-use integrations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCoven/desktop-use.git"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && cargo test"
  },
  "dependencies": {
    "typebox": "1.1.34"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "openclaw": "2026.4.26",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.26",
      "minGatewayVersion": "2026.4.26"
    },
    "build": {
      "openclawVersion": "2026.4.26",
      "pluginSdkVersion": "2026.4.26"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
