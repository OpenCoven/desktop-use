{
  "name": "@opencoven/openclaw-desktop-use",
  "version": "0.1.3",
  "description": "OpenCoven desktop-use adapter and OpenClaw plugin for computer-use integrations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCoven/desktop-use.git"
  },
  "files": [
    "dist/**",
    "agents/**/*",
    "docs/*.md",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ts": "pnpm run build && tsx --test \"src/**/*.test.ts\" scripts/gateway-action-batches.test.mjs",
    "check": "pnpm run check:contracts && pnpm run typecheck && pnpm run test:ts && pnpm run test:gateway-fixture && pnpm run test:runtime-graphs && pnpm run check:plugin-runtime-imports && node scripts/check-plugin-runtime-imports.mjs --compiled && cargo test",
    "generate:contracts": "tsx scripts/generate-capabilities-contract.ts",
    "check:contracts": "tsx scripts/generate-capabilities-contract.ts --check",
    "check:plugin-runtime-imports": "node scripts/check-plugin-runtime-imports.mjs",
    "test:gateway-fixture": "node --test scripts/gateway-image-fixture.test.mjs scripts/packed-metadata.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test:packed": "node scripts/test-packed-consumers.mjs",
    "test:runtime-graphs": "node --test scripts/check-plugin-runtime-imports.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "25.6.0",
    "jpeg-js": "0.4.4",
    "openclaw": "2026.4.26",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.26",
      "minGatewayVersion": "2026.4.26"
    },
    "build": {
      "openclawVersion": "2026.4.26",
      "pluginSdkVersion": "2026.4.26"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk.d.ts",
      "import": "./dist/src/sdk.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "import": "./dist/src/contracts.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "coven-desktop-use-mcp": "./dist/src/mcp/main.js"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
