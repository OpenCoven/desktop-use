{
  "name": "@opencoven/openclaw-desktop-use",
  "version": "0.1.2",
  "description": "OpenCoven desktop-use adapter and OpenClaw plugin for computer-use integrations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCoven/desktop-use.git"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "contracts/v1/observation.schema.json",
    "contracts/v1/capabilities.schema.json",
    "contracts/v1/canonical-actions.json",
    "contracts/v1/canonical-actions.schema.json",
    "agents/**/*",
    "docs/**/*.md",
    "scripts/check-plugin-runtime-imports.mjs",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ts": "tsx --test src/**/*.test.ts scripts/gateway-action-batches.test.mjs",
    "check": "pnpm run check:contracts && pnpm run typecheck && pnpm run test:ts && pnpm run test:gateway-fixture && pnpm run check:plugin-runtime-imports && cargo test",
    "generate:contracts": "tsx scripts/generate-capabilities-contract.ts",
    "check:contracts": "tsx scripts/generate-capabilities-contract.ts --check",
    "check:plugin-runtime-imports": "node scripts/check-plugin-runtime-imports.mjs",
    "test:gateway-fixture": "node --test scripts/gateway-image-fixture.test.mjs"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "ajv": "8.20.0",
    "jpeg-js": "0.4.4",
    "openclaw": "2026.4.26",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.26",
      "minGatewayVersion": "2026.4.26"
    },
    "build": {
      "openclawVersion": "2026.4.26",
      "pluginSdkVersion": "2026.4.26"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
